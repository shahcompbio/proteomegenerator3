/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
    ]

    withName: '.*:STRINGTIE_MERGE.*' {
        ext.args = { "-T ${params.min_stringtie_tpm}" }
    }

    withName: '.*:TRANSDECODER2FASTA.*|.*:MERGEFUSIONS.*|.*:FUSIONFASTA.*' {
        publishDir = [path: { "${params.outdir}/proteome" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }

    withName: '.*:CAT_CAT.*' {
        publishDir = [enabled: false]
    }

    withName: '.*:SEQKIT_RMDUP.*' {
        ext.args   = "-s"
        ext.prefix = { "${meta.id}.proteome" }
        publishDir = [
            path: { "${params.outdir}/proteome" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:SEQKIT_STATS.*' {
        ext.prefix = { "${meta.id}.seqkit_stats" }
        publishDir = [
            path: { "${params.outdir}/proteome" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: DIAMOND_BLASTP {
        ext.args = { "--max-target-seqs 1 --evalue ${params.max_evalue}" }
    }

    //
    // BAM_QC subworkflow modules
    //
    withName: '.*:BAM_QC:SAMTOOLS_SORT' {
        publishDir = [enabled: false]
    }

    withName: '.*:BAM_QC:SAMTOOLS_INDEX' {
        publishDir = [enabled: false]
    }

    withName: '.*:BAM_QC:SAMTOOLS_STATS' {
        publishDir = [
            path: { "${params.outdir}/qc/samtools" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:BAM_QC:NANOPLOT' {
        cpus   = { 4 * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 6.h * task.attempt }
        ext.args   = { "--bam ${ontfile} --prefix ${meta.id}. --tsv_stats" }
        publishDir = [
            path: { "${params.outdir}/qc/nanoplot" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:BAM_QC:RSEQC_BAMSTAT' {
        publishDir = [
            path: { "${params.outdir}/qc/rseqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:BAM_QC:UCSC_GTFTOGENEPRED' {
        ext.args   = '-genePredExt -geneNameAsName2'
        publishDir = [enabled: false]
    }

    withName: '.*:BAM_QC:PICARD_COLLECTRNASEQMETRICS' {
        ext.args   = '--STRAND_SPECIFICITY NONE --VALIDATION_STRINGENCY LENIENT'
        publishDir = [
            path: { "${params.outdir}/qc/picard" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:BAMBU.*' {
        publishDir = [
            path: { "${params.outdir}/bambu/${meta.id}/transcriptome" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }


    withName: 'KENTSISLAB_PROTEOMEGENERATOR3:PROTEOMEGENERATOR3:BAM_ASSEMBLY_BAMBU:BAMBU_FILTER' {
        ext.args   = { "--min_cts=${params.min_lr_cts}" }
        ext.prefix = { "${meta.id}.bambu.detected" }
        publishDir = [
            path: { "${params.outdir}/bambu/${meta.id}/transcriptome" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'KENTSISLAB_PROTEOMEGENERATOR3:PROTEOMEGENERATOR3:PREPROCESS_READS:BAMBU_READCLASSES' {
        publishDir = [
            path: { "${params.outdir}/bambu/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
    withName: '.*:(TRANSDECODER_PREDICT|TRANSDECODER_LONGORF)' {
        publishDir = [
            path: { "${params.outdir}/transdecoder" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:TRANSDECODER_PREDICT.*' {
        ext.args = params.single_best_only ? '--single_best_only' : ''
    }

    withName: '.*:TRANSDECODER_LONGORF.*' {
        ext.args = { params.ignore_strands ? "-m ${params.min_orf_len}" : "-m ${params.min_orf_len} -S" }
    }

    withName: GFFREAD {
        ext.args   = '-w'
        ext.prefix = { meta.tool ? "${meta.id}.${meta.tool}" : meta.id }
    }

    withName: SAMTOOLS_VIEW {
        ext.prefix = { "${meta.id}.filtered" }
        ext.args   = '--output-fmt bam'
        ext.args2  = [
            "chr1",
            "chr2",
            "chr3",
            "chr4",
            "chr5",
            "chr6",
            "chr7",
            "chr8",
            "chr9",
            "chr10",
            "chr11",
            "chr12",
            "chr13",
            "chr14",
            "chr15",
            "chr16",
            "chr17",
            "chr18",
            "chr19",
            "chr20",
            "chr21",
            "chr22",
            "chrX",
            "chrY",
            "chrM",
        ].join(' ')
        publishDir = [enabled: false]
    }

    withName: FILTER_READS {
        ext.prefix = { "${meta.id}.filtered" }
        ext.args   = "-e \"mapq >= ${params.mapq} && length(seq) >= ${params.read_len} \" --output-fmt bam"
        ext.args2  = ""
        cpus       = { 5 * task.attempt }
        memory     = { 30.GB * task.attempt }
        time       = { 4.h * task.attempt }
        publishDir = [enabled: false]
    }

    withName: '.*:PREPROCESS_READS:SAMTOOLS_CONVERT' {
        ext.prefix = { "${meta.id}.filtered" }
        publishDir = [
            path: { "${params.outdir}/filtered_cram" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: CRAM_TO_BAM {
        publishDir = [enabled: false]
    }

    withName: BAMBU_READCLASSES {
        cpus   = { 1 * task.attempt }
        memory = { 200.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: BAMBU_MERGE {
        ext.args      = "--quant=FALSE --lowMemory=FALSE"
        ext.yieldsize = "NULL"
        cpus          = { 1 }
        memory        = { rds.size() > 20 ? 300.GB * task.attempt : 200.GB * task.attempt }
        time          = { rds.size() > 20 ? 24.h * task.attempt : 12.h * task.attempt }
    }

    withName: '.*:BAMBU_MERGE_QUANT.*' {
        container  = "quay.io/shahlab_singularity/bambu:HongYhong_fix"
        ext.args   = "--discovery=FALSE"
        cpus       = { 1 }
        memory     = { 100.GB * task.attempt }
        time       = { 2.h * task.attempt }
        maxRetries = 2
        publishDir = [
            path: { "${params.outdir}/bambu/merge/transcriptome/quant/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:SEMERGE.*' {
        publishDir = [
            path: { "${params.outdir}/bambu/${meta.id}/transcriptome" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: MULTIQC {
        ext.args   = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    //
    // LRAA modules
    //
    withName: '.*:LRAA_ASSEMBLY.*' {
        cpus          = 16
        memory        = { 96.GB * task.attempt }
        time          = { 16.h * task.attempt }
        errorStrategy = { task.exitStatus in ((130..145) + 104 + 1 + Integer.MAX_VALUE) ? 'retry' : 'finish' }
        maxRetries    = 2
        publishDir    = [
            path: { "${params.outdir}/lraa/assembly/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:LRAA_MERGE.*' {
        publishDir = [
            path: { "${params.outdir}/lraa/merged" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:LRAA_QUANT$' {
        publishDir = [
            path: { "${params.outdir}/lraa/quant/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:LRAA_QUANTMERGE$' {
        publishDir = [
            path: { "${params.outdir}/lraa/quant" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    //
    // StringTie long-read mode: pass -L flag only for the LR-aliased instance
    //
    withName: 'KENTSISLAB_PROTEOMEGENERATOR3:PROTEOMEGENERATOR3:BAM_ASSEMBLY_STRINGTIE_LR:STRINGTIE_STRINGTIE' {
        ext.args   = '-L'
        publishDir = [
            path: { "${params.outdir}/stringtie_lr" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
    // short-read stringtie assembly: do not pass -L flag
    withName: 'KENTSISLAB_PROTEOMEGENERATOR3:PROTEOMEGENERATOR3:BAM_ASSEMBLY_STRINGTIE_SR:STRINGTIE_STRINGTIE' {
        ext.args   = ''
        publishDir = [
            path: { "${params.outdir}/stringtie_sr" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    //
    // LRAA reannotation: use LRAA-specific novel transcript/gene prefixes
    //
    withName: '.*:BAM_ASSEMBLY_LRAA:REANNOTATEGTF' {
        ext.args   = '--tool lraa'
        ext.prefix = { "${meta.id}.lraa" }
        publishDir = [
            path: { "${params.outdir}/lraa/reannotation" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    //
    // StringTie LR reannotation: use StringTie-specific novel transcript/gene prefixes
    //
    withName: '.*:BAM_ASSEMBLY_STRINGTIE_LR:REANNOTATEGTF' {
        ext.args   = '--tool stringtie'
        ext.prefix = { "${meta.id}.stringtie_lr" }
        publishDir = [
            path: { "${params.outdir}/stringtie_lr/reannotation" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }


    //
    // GTF merge modules (multi-assembler union & ORFs-only mode)
    //
    withName: '.*:(GTF_MERGE_SQANTI|GTF_MERGE_ORFS_ONLY):LRAA_MERGE' {
        ext.prefix = { "${meta.id}.lraa_merge" }
        ext.args   = { params.include_single_exons ? '' : '--exclude_SE_transcripts' }
        publishDir = [
            path: { "${params.outdir}/transcriptome/raw/lraa_merge" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:(GTF_MERGE_SQANTI|GTF_MERGE_ORFS_ONLY):GFFCOMPARE' {
        publishDir = [enabled: false]
    }

    withName: '.*:(GTF_MERGE_SQANTI|GTF_MERGE_ORFS_ONLY):REANNOTATEGTF' {
        ext.args   = '--tool union'
        ext.prefix = { "${meta.id}.union" }
        publishDir = [
            path: { "${params.outdir}/transcriptome/raw" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:GFFCOMPARE_PROVENANCE' {
        publishDir = [
            path: { "${params.outdir}/transcriptome/raw/gffcompare" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    //
    // SQANTI3 transcriptome curation
    //
    withName: '.*:(GTF_MERGE_SQANTI|GTF_MERGE_ORFS_ONLY):SQANTI3_QC' {
        publishDir = [
            path: { "${params.outdir}/transcriptome/sqanti3/prefiltered_qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:(GTF_MERGE_SQANTI|GTF_MERGE_ORFS_ONLY):SQANTI3_FILTER' {
        ext.filter_type = { params.sqanti3_filter_type }
        ext.args        = { params.include_single_exons ? '' : '--filter_mono_exonic' }
        publishDir      = [
            path: { "${params.outdir}/transcriptome/sqanti3/filter" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:(GTF_MERGE_SQANTI|GTF_MERGE_ORFS_ONLY):SQANTI3_RESCUE' {
        ext.rescue_type = { params.sqanti3_filter_type }
        publishDir      = [
            path: { "${params.outdir}/transcriptome/sqanti3/final_transcriptome" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:(GTF_MERGE_SQANTI|GTF_MERGE_ORFS_ONLY):SQANTI3_QC_FINAL' {
        publishDir = [
            path: { "${params.outdir}/transcriptome/sqanti3/final_qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*SQANTI3_QC' {
        ext.args = '-n 8'
        cpus     = 8
        memory   = { 72.GB * task.attempt }
        time     = { 1.h * task.attempt }
        // Retry on transient gffread .fai race condition in parallel splits
        errorStrategy = { task.exitStatus in ((130..145) + 104 + [1]) ? 'retry' : 'finish' }
        maxRetries    = 2
    }

    withName: '.*SQANTI3_(FILTER|RESCUE)' {
        memory = { 72.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
}
