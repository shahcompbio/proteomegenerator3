nextflow_pipeline {

    name "Test union assembly is skipped when only one assembler is selected"
    script "../main.nf"
    tag "pipeline"
    tag "union_assembly"

    // The union path (GFFCOMPARE -> REANNOTATEGTF in GTF_MERGE_SQANTI) exists to
    // merge across assemblers. Running it on a single assembler re-annotates an
    // already-annotated GTF and drops reference gene IDs, so it must not run.
    //
    // REANNOTATEGTF in GTF_MERGE_SQANTI publishes to transcriptome/raw with
    // ext.prefix "${meta.id}.union" (conf/modules.config), so the presence of a
    // *.union.reannotated.gtf is a direct marker for whether that pass executed.
    // Asserting on workflow.success alone would not catch this -- the broken
    // pipeline completed successfully and silently emitted NovelGene IDs.

    test("Single assembler — union reannotation must not run") {
        options "-stub"
        when {
            params {
                input = 'https://raw.githubusercontent.com/apsteinberg/test-datasets/refs/heads/proteomegenerator3/samplesheet_multisample_nofusions.csv'
                // Genome references
                fasta = 'https://raw.githubusercontent.com/apsteinberg/test-datasets/refs/heads/proteomegenerator3/reference/Homo_sapiens.GRCh38.dna_sm.primary_assembly_chr9_1_1000000.fa'
                gtf = 'https://raw.githubusercontent.com/apsteinberg/test-datasets/refs/heads/proteomegenerator3/reference/Homo_sapiens.GRCh38.91_chr9_1_1000000.gtf'
                outdir = "$outputDir"
                long_read_assembler = 'bambu'
                skip_preprocessing = true
                skip_qc = true
            }
        }

        then {
            def unionGtfs = new File("${outputDir}/transcriptome/raw")
                .listFiles()
                ?.findAll { it.name.endsWith('.union.reannotated.gtf') } ?: []

            assert workflow.success
            assert unionGtfs.isEmpty() : "union reannotation ran for a single assembler: ${unionGtfs*.name}"
        }
    }

    test("Multiple assemblers — union reannotation must run") {
        options "-stub"
        when {
            params {
                input = 'https://raw.githubusercontent.com/apsteinberg/test-datasets/refs/heads/proteomegenerator3/samplesheet_multisample_nofusions.csv'
                // Genome references
                fasta = 'https://raw.githubusercontent.com/apsteinberg/test-datasets/refs/heads/proteomegenerator3/reference/Homo_sapiens.GRCh38.dna_sm.primary_assembly_chr9_1_1000000.fa'
                gtf = 'https://raw.githubusercontent.com/apsteinberg/test-datasets/refs/heads/proteomegenerator3/reference/Homo_sapiens.GRCh38.91_chr9_1_1000000.gtf'
                outdir = "$outputDir"
                long_read_assembler = 'bambu,stringtie'
                skip_preprocessing = true
                skip_qc = true
            }
        }

        then {
            def unionGtfs = new File("${outputDir}/transcriptome/raw")
                .listFiles()
                ?.findAll { it.name.endsWith('.union.reannotated.gtf') } ?: []

            assert workflow.success
            assert !unionGtfs.isEmpty() : "union reannotation did not run for multiple assemblers"
        }
    }
}
