nextflow_workflow {

    name "Test Subworkflow PREPROCESS_READS"
    script "../main.nf"
    workflow "PREPROCESS_READS"

    tag "subworkflows"
    tag "subworkflows/preprocess_reads"
    tag "samtools"
    tag "samtools/index"
    tag "samtools/convert"

    test("filter_reads - bam to cram conversion") {
        options "-stub"
        when {
            params {
                fasta = 'https://raw.githubusercontent.com/apsteinberg/test-datasets/refs/heads/proteomegenerator3/reference/Homo_sapiens.GRCh38.dna_sm.primary_assembly_chr9_1_1000000.fa'
                gtf = 'https://raw.githubusercontent.com/apsteinberg/test-datasets/refs/heads/proteomegenerator3/reference/Homo_sapiens.GRCh38.91_chr9_1_1000000.gtf'
                mapq = 20
                read_len = 500
                yieldsize = 100000
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                ])
                input[1] = true
                input[2] = false
                input[3] = 'bambu'
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bam },
                { assert workflow.out.cram },
            )
        }
    }

    test("no filtering - no cram conversion") {
        options "-stub"
        when {
            params {
                fasta = 'https://raw.githubusercontent.com/apsteinberg/test-datasets/refs/heads/proteomegenerator3/reference/Homo_sapiens.GRCh38.dna_sm.primary_assembly_chr9_1_1000000.fa'
                gtf = 'https://raw.githubusercontent.com/apsteinberg/test-datasets/refs/heads/proteomegenerator3/reference/Homo_sapiens.GRCh38.91_chr9_1_1000000.gtf'
                yieldsize = 100000
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                ])
                input[1] = false
                input[2] = false
                input[3] = 'bambu'
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bam },
            )
        }
    }
}
